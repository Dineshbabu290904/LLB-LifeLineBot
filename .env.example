# ─────────────────────────────────────────────────────────────────────────────
# MEDBOT Platform – Environment Variables
# Copy this file to .env and fill in real values before running.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development       # development | staging | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
DEBUG=false

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# IMPORTANT: Change this to a long random string in production
JWT_SECRET_KEY=medbot-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URL=mongodb://mongodb:27017
MONGO_DB_NAME=medbot

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql://medbot_user:medbot_pass@postgresql:5432/medbot

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_TTL_SECONDS=3600

# ── Ollama (LLM) ──────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_REASONING_MODEL=llama3.2:latest
OLLAMA_VISION_MODEL=llava:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_CLASSIFICATION_MODEL=phi3:mini

# ── FAISS Vector Store ────────────────────────────────────────────────────────
FAISS_INDEX_PATH=/data/faiss_index
FAISS_DIMENSION=384
FAISS_TOP_K=5

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── Safety / Quality Thresholds ───────────────────────────────────────────────
HALLUCINATION_THRESHOLD=0.3
QUALITY_THRESHOLD=0.7
RETRAIN_DATASET_SIZE=1000

# ── External APIs (optional) ──────────────────────────────────────────────────
# PubMed API key for higher request limits (free at https://ncbi.nlm.nih.gov)
PUBMED_API_KEY=

# Web search API key (Serper, SerpAPI, Brave, etc.)
WEB_SEARCH_API_KEY=

# ── Grafana (monitoring stack only) ──────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=medbot-admin
